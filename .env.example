# 复制为 .env 后填写真实值；.env 已加入 .gitignore，切勿提交真实凭据
# 打包后的用户数据目录由 Electron 传入 SPIDER_GD_HOME（userData）。
# 未设置时仍使用当前工作目录，便于开发和测试。

# 平台登录凭据
CRAWLER__USERNAME=your_username
CRAWLER__PASSWORD=your_password
CRAWLER__CERT_PASSWORD=your_cert_pin

# 钉钉告警（联网模式可选）
ALERT__DINGTALK_WEBHOOK=
ALERT__DINGTALK_SECRET=

# 远程 Agent（可选，可拆卸）
AGENT__ENABLED=false
AGENT__MAX_PERMISSION=readonly
